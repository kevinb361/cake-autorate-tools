# /etc/cake-autorate-tools/bridge-<wan>.env, read by cake-autorate-state-bridge@<wan>.service.
# Replace every <placeholder>. Set all interface values explicitly: the bridge's built-in
# interface defaults are those of the deployment it came from and will not match yours.
WANCTL_EXTERNAL_WAN_NAME=<wan>
# Interface whose egress CAKE qdisc shapes download (the LAN-facing side of an inline bridge).
WANCTL_EXTERNAL_DL_IF=<download-interface>
# Interface whose egress CAKE qdisc shapes upload (the modem-facing side).
WANCTL_EXTERNAL_UL_IF=<upload-interface>
CAKE_AUTORATE_BRIDGE_LOG=/var/log/cake-autorate/cake-autorate.<wan>.log
WANCTL_EXTERNAL_STATE_PATH=/var/lib/wanctl/<wan>_state.json
# Must be a regular file under /var/lib/wanctl, not a symlink into /run/wanctl.
WANCTL_EXTERNAL_METRICS_DB=/var/lib/wanctl/metrics-<wan>.db
# Idle RTT to the ping hosts in ms. Measure it on your link.
WANCTL_EXTERNAL_BASELINE_RTT=<idle-rtt-ms>
# Address on the shaper that routes out of this WAN (empty: kernel default).
WANCTL_EXTERNAL_PING_SOURCE_IP=<source-address>
WANCTL_EXTERNAL_PING_HOSTS=1.1.1.1,9.9.9.9
# /health listener; keep it loopback or on a firewall-restricted management address.
# Give each WAN's instance its own host:port pair (for example 9101 and 9102 on loopback).
CAKE_AUTORATE_BRIDGE_HEALTH_HOST=127.0.0.1
CAKE_AUTORATE_BRIDGE_HEALTH_PORT=<health-port>
# Required: the account the metrics exporter runs as (default User=wanctl). The state file is written mode 0600 and
# chowned to these IDs; with the built-in default of 988, or with CHOWN=0, the exporter cannot read it.
WANCTL_STATE_UID=<exporter-uid>
WANCTL_STATE_GID=<exporter-gid>
WANCTL_STATE_CHOWN=1
